{
  "name": "sporen-agenda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agenda voor leefgroep en jongeren: versleuteld in de browser, opslag in Supabase",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "rooktest": "node --env-file=.env.local scripts/rooktest.mjs",
    "schema:supabase": "supabase db query --remote -f supabase/schema.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "supabase": "^3.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}